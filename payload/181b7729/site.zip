                    <i class="fas fa-shopping-bag"></i> Pesanan
                </div>
                <div class="menu-item" onclick="navigateTo('adminUsers')">
                    <i class="fas fa-users"></i> User
                </div>
                <div class="menu-item" onclick="navigateTo('adminPayments')">
                    <i class="fas fa-credit-card"></i> Pembayaran
                </div>
