                <div class="menu-item active" onclick="navigateTo('adminOrders')">
                    <i class="fas fa-shopping-bag"></i> Pesanan
                </div>
                <div class="menu-item" onclick="navigateTo('adminUsers')">
                    <i class="fas fa-users"></i> User
                </div>
                <div class="menu-item" onclick="navigateTo('adminPayments')">
                    <i class="fas fa-credit-card"></i> Pembayaran
                </div>
                <div class="menu-item" onclick="navigateTo('adminChat')">
                    <i class="fas fa-comment"></i> Chat CS
                </div>
                <div class="menu-item" onclick="navigateTo('adminTestimonials')">
                    <i class="fas fa-star"></i> Testimoni
                </div>
                <div class="menu-item" onclick="navigateTo('adminSettings')">
                    <i class="fas fa-cog"></i> Pengaturan
                </div>
