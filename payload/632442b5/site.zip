                const express = require("express");
const cors = require("cors");
const jwt = require("jsonwebtoken");
const bcrypt = require("bcryptjs");

const app = express();
app.use(cors());
app.use(express.json());

const PORT = process.env.PORT || 3000;
const SECRET = process.env.JWT_SECRET || "CHANGE_THIS_SECRET";

const users = [
  {
    id: 1,
    username: "admin",
    password: bcrypt.hashSync("admin123", 10),
    role: "ADMIN"
  },
  {
    id: 2,
    username: "reseller",
    password: bcrypt.hashSync("reseller123", 10),
    role: "RESELLER"
  },
  {
    id: 3,
    username: "member",
    password: bcrypt.hashSync("member123", 10),
    role: "MEMBER"
  },
  {
    id: 4,
    username: "sender",
    password: bcrypt.hashSync("sender123", 10),
    role: "SENDER"
  }
];

function auth(req, res, next) {
  const header = req.headers.authorization;

  if (!header?.startsWith("Bearer ")) {
    return res.status(401).json({
      success: false,
      message: "Token diperlukan"
    });
  }

  try {
    req.user = jwt.verify(
      header.substring(7),
      SECRET
    );

    next();
  } catch {
    res.status(401).json({
      success: false,
      message: "Token tidak valid"
    });
  }
}

function role(...roles) {
  return (req, res, next) => {
    if (!roles.includes(req.user.role)) {
      return res.status(403).json({
        success: false,
        message: "Akses ditolak"
      });
    }

    next();
  };
}

app.get("/", (_, res) => {
  res.json({
    name: "SafeSender API",
    status: "online"
  });
});

app.post("/api/login", async (req, res) => {
  const { username, password } = req.body;

  const user = users.find(
    x => x.username === username
  );

  if (!user) {
    return res.status(401).json({
      success: false,
      message: "Username/password salah"
    });
  }

  const valid = await bcrypt.compare(
    password,
    user.password
  );

  if (!valid) {
    return res.status(401).json({
      success: false,
      message: "Username/password salah"
    });
  }

  const token = jwt.sign(
    {
      id: user.id,
      username: user.username,
      role: user.role
    },
    SECRET,
    { expiresIn: "24h" }
  );

  res.json({
    success: true,
    token,
    user: {
      username: user.username,
      role: user.role
    }
  });
});

app.get(
  "/api/dashboard",
  auth,
  (req, res) => {
    res.json({
      success: true,
      message: "Dashboard berhasil dibuka",
      user: req.user
    });
  }
);

app.get(
  "/api/admin/users",
  auth,
  role("ADMIN"),
  (_, res) => {
    res.json({
      success: true,
      users: users.map(u => ({
        id: u.id,
        username: u.username,
        role: u.role
      }))
    });
  }
);

app.post(
  "/api/send",
  auth,
  role("ADMIN", "RESELLER", "SENDER"),
  (req, res) => {
    const { destination, message } = req.body;

    if (!destination || !message) {
      return res.status(400).json({
        success: false,
        message: "Destination dan message wajib diisi"
      });
    }

    /*
      Hubungkan di sini ke provider/API resmi
      yang mengizinkan pengiriman pesan dan
      hanya gunakan untuk penerima yang memberikan
      izin.
    */

    res.json({
      success: true,
      status: "accepted",
      destination,
      message
    });
  }
);

app.listen(PORT, () => {
  console.log(
    `SafeSender API berjalan di port ${PORT}`
  );
});



