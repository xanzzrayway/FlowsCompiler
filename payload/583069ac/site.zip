<title>Chat Gojo</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#050810;color:#e9edef;height:100vh;overflow:hidden}
#bg{position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(circle at 20% 30%,rgba(88,28,135,.4) 0,transparent 50%),radial-gradient(circle at 80% 70%,rgba(30,64,175,.4) 0,transparent 50%),#050810}
#bg::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at center,transparent 0,rgba(0,0,0,.6) 100%)}
#auth{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.card{width:100%;max-width:380px;background:rgba(31,44,52,.75);backdrop-filter:blur(20px);border:1px solid rgba(139,92,246,.3);border-radius:20px;padding:32px 24px;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(139,92,246,.2)}
.logo{width:64px;height:64px;margin:0 auto 16px;background:linear-gradient(135deg,#8b5cf6,#3b82f6);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.8rem;box-shadow:0 8px 32px rgba(139,92,246,.5)}
h1{text-align:center;font-size:1.4rem;margin-bottom:4px}
.sub{text-align:center;color:#a0a8b8;font-size:.85rem;margin-bottom:20px}
label{display:block;color:#a0a8b8;font-size:.8rem;margin-bottom:6px;margin-top:12px;font-weight:500}
input{width:100%;padding:12px 16px;background:rgba(42,57,66,.7);border:1px solid rgba(139,92,246,.15);border-radius:10px;color:#e9edef;font-size:.95rem;outline:none;transition:.2s}
input:focus{border-color:#8b5cf6;background:rgba(11,20,26,.9);box-shadow:0 0 0 3px rgba(139,92,246,.2)}
input::placeholder{color:#667781}
.err{color:#f15c6d;font-size:.8rem;min-height:18px;margin-top:8px;text-align:center}
.btn{width:100%;padding:14px;background:linear-gradient(135deg,#8b5cf6,#3b82f6);color:#fff;border:none;border-radius:10px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:16px;box-shadow:0 8px 24px rgba(139,92,246,.4);transition:.2s}
