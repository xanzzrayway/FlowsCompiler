<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, 'Segoe UI', Roboto, sans-serif;
  background: #0d1117;
  color: #c9d1d9;
  min-height: 100vh;
  padding: 24px 16px;
}
.container {
  max-width: 640px;
  margin: 0 auto;
}
h1 {
  color: #58a6ff;
  font-size: 1.5rem;
  margin-bottom: 8px;
}
.sub {
  color: #8b949e;
  font-size: 0.9rem;
  margin-bottom: 24px;
}
.section {
  font-size: 0.75rem;
  color: #8b949e;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 24px 0 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.section::before, .section::after {
  content: '';
  flex: 1;
  height: 1px;
  background: #30363d;
}
.menu {
  display: grid;
  gap: 12px;
}
.card {
  display: block;
  background: #161b22;
  border: 1px solid #30363d;
  border-radius: 10px;
  padding: 16px 20px;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: #58a6ff;
  transform: scaleY(0);
  transition: transform 0.2s;
}
.card:hover {
  border-color: #58a6ff;
  transform: translateX(4px);
  background: #1c2128;
}
.card:hover::before {
  transform: scaleY(1);
}
.card .badge {
  display: inline-block;
  background: #1f6feb;
  color: white;
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: 10px;
  margin-bottom: 6px;
  font-weight: 600;
  text-transform: uppercase;
}
.card .badge.green { background: #238636; }
.card .badge.purple { background: #8957e5; }
.card .badge.orange { background: #d29922; }
.card h3 {
  color: #58a6ff;
  font-size: 1rem;
  margin-bottom: 4px;
}
.card p {
  font-size: 0.8rem;
  color: #8b949e;
  line-height: 1.5;
}
.warn {
  margin-top: 24px;
  background: #3d1f1f;
  border-left: 4px solid #f85149;
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 0.85rem;
  color: #ffa198;
}
.warn code {
  background: #0d1117;
  padding: 2px 6px;
  border-radius: 4px;
  color: #7ee787;
  font-family: monospace;
}
</style>
</head>
<body>
