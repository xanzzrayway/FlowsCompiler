<title>Chat Gojo</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#050810;color:#e9edef;height:100vh;overflow:hidden}
#bg{position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(circle at 20% 30%,rgba(88,28,135,.4) 0,transparent 50%),radial-gradient(circle at 80% 70%,rgba(30,64,175,.4) 0,transparent 50%),#050810}
#bg::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at center,transparent 0,rgba(0,0,0,.6) 100%)}
#auth{position:fixed;inset:0;z-index:10;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.card{width:100%;max-width:380px;background:rgba(31,44,52,.75);backdrop-filter:blur(20px);border:1px solid rgba(139,92,246,.3);border-radius:20px;padding:32px 24px;box-shadow:0 20px 60px rgba(0,0,0,.5),0 0 40px rgba(139,92,246,.2)}
.logo{width:64px;height:64px;margin:0 auto 16px;background:linear-gradient(135deg,#8b5cf6,#3b82f6);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.8rem;box-shadow:0 8px 32px rgba(139,92,246,.5)}
h1{text-align:center;font-size:1.4rem;margin-bottom:4px}
.sub{text-align:center;color:#a0a8b8;font-size:.85rem;margin-bottom:20px}
label{display:block;color:#a0a8b8;font-size:.8rem;margin-bottom:6px;margin-top:12px;font-weight:500}
input{width:100%;padding:12px 16px;background:rgba(42,57,66,.7);border:1px solid rgba(139,92,246,.15);border-radius:10px;color:#e9edef;font-size:.95rem;outline:none;transition:.2s}
input:focus{border-color:#8b5cf6;background:rgba(11,20,26,.9);box-shadow:0 0 0 3px rgba(139,92,246,.2)}
input::placeholder{color:#667781}
.err{color:#f15c6d;font-size:.8rem;min-height:18px;margin-top:8px;text-align:center}
.btn{width:100%;padding:14px;background:linear-gradient(135deg,#8b5cf6,#3b82f6);color:#fff;border:none;border-radius:10px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:16px;box-shadow:0 8px 24px rgba(139,92,246,.4);transition:.2s}
.btn:hover{transform:translateY(-1px)}
.btn:disabled{background:#3b4a54;box-shadow:none;cursor:not-allowed}
.switch{text-align:center;margin-top:16px;font-size:.85rem;color:#a0a8b8}
.switch a{color:#a78bfa;font-weight:600;cursor:pointer;margin-left:4px}
#chat{display:none;flex-direction:column;height:100vh;max-width:600px;margin:0 auto;position:relative;z-index:5}
#chat.active{display:flex}
.hd{background:rgba(31,44,52,.85);backdrop-filter:blur(20px);border-bottom:1px solid rgba(139,92,246,.2);padding:10px 12px;display:flex;align-items:center;justify-content:space-between;height:60px;flex-shrink:0}
.hl{display:flex;align-items:center;gap:10px;flex:1;min-width:0}
.av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#8b5cf6,#3b82f6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;flex-shrink:0;box-shadow:0 4px 12px rgba(139,92,246,.4)}
.ci{min-width:0;overflow:hidden}
.cn{font-size:1rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cs{font-size:.75rem;color:#a78bfa}
.hr{display:flex;gap:12px;color:#aebac1;font-size:1.2rem}
.hr .ic{cursor:pointer;padding:4px;user-select:none}
.body{flex:1;overflow-y:auto;padding:16px 12px;display:flex;flex-direction:column;gap:4px}
.notice{background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);color:#c4b5fd;font-size:.75rem;text-align:center;padding:6px 12px;border-radius:8px;align-self:center;max-width:90%;margin-bottom:12px}
.bb{max-width:75%;padding:8px 12px 6px;border-radius:8px;font-size:.95rem;line-height:1.35;word-wrap:break-word;margin-bottom:2px;animation:bi .2s}
@keyframes bi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
.bb.in{background:rgba(31,44,52,.85);backdrop-filter:blur(10px);border:1px solid rgba(139,92,246,.15);align-self:flex-start;border-top-left-radius:2px}
.bb.out{background:rgba(88,28,135,.6);backdrop-filter:blur(10px);border:1px solid rgba(139,92,246,.4);align-self:flex-end;border-top-right-radius:2px;box-shadow:0 4px 20px rgba(139,92,246,.2)}
.bb .snd{display:block;font-size:.7rem;font-weight:700;color:#a78bfa;margin-bottom:2px}
.bb .txt{display:block;margin-bottom:4px}
.bb .mt{display:flex;justify-content:flex-end;font-size:.65rem;color:#a0a8b8}
.ib{background:rgba(31,44,52,.85);backdrop-filter:blur(20px);border-top:1px solid rgba(139,92,246,.2);padding:8px 10px;display:flex;align-items:center;gap:8px;flex-shrink:0}
.iw{flex:1;background:rgba(42,57,66,.7);border:1px solid rgba(139,92,246,.15);border-radius:24px;display:flex;align-items:center;padding:6px 12px;gap:8px}
.iw input{flex:1;background:transparent;border:none;outline:none;color:#e9edef;font-size:.95rem;padding:6px 0}
.iw .em{font-size:1.2rem;color:#a0a8b8}
.sb{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#8b5cf6,#3b82f6);color:#fff;border:none;font-size:1.2rem;cursor:pointer;flex-shrink:0;box-shadow:0 4px 16px rgba(139,92,246,.5)}
.sb:active{transform:scale(.92)}
.ld{text-align:center;color:#a0a8b8;padding:20px;font-size:.85rem}
</style>
</head>
<body>
<div id="bg"></div>
<div id="auth">
  <div class="card">
    <div class="logo">✨</div>
    <h1 id="tTitle">Masuk</h1>
    <p class="sub" id="tSub">Login ke akun kamu</p>
    <form id="form">
      <label>Email</label>
      <input type="email" id="em" placeholder="nama@email.com">
      <label>Password</label>
      <input type="password" id="pw" placeholder="min 6 karakter">
      <label id="nl" style="display:none">Nama Tampilan</label>
      <input type="text" id="